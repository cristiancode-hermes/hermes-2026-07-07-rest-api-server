# ── Servidor ─────────────────────────────────────────────────────────────
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# ── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=info          # trace, debug, info, warn, error, critical
LOG_PATTERN=[%Y-%m-%d %H:%M:%S.%e] [%^%l%$] %v

# ── Rate Limiting ────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SEC=60

# ── CORS ─────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=*

# ── API Keys ─────────────────────────────────────────────────────────────
# API_KEY=your-api-key-here
